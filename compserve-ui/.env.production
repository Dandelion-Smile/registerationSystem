# 页面标题
VITE_APP_TITLE = 河南工业大学第三届“讯飞杯”AI+创新应用大赛报名平台

# 生产环境配置
VITE_APP_ENV = 'production'

# 竞赛服务平台/生产环境
VITE_APP_BASE_API = '/prod-api'

# 是否在打包时开启压缩，支持 gzip 和 brotli
VITE_BUILD_COMPRESS = gzip

# OnlyOffice API
VITE_APP_ONLYOFFICE_API = 'http://117.72.79.75:8080/web-apps/apps/api/documents/api.js'

# 代理服务地址
VITE_APP_PROXY_API_URL = '/api/run'

# Coze API Token
VITE_APP_COZE_API_TOKEN = 'your-actual-token-here'

# 文件上传服务地址
VITE_APP_UPLOAD_API_URL = '/api/upload'

# MinIO 文件访问地址 (注意：必须是 9000 端口，不能是 9001)
VITE_APP_MINIO_URL = 'http://117.72.79.75:9001'
