# Copy this file to deploy/docker/.env on the server and fill in real values.

# Container / compose project
COMPOSE_PROJECT_NAME=compserve
TZ=Asia/Shanghai

# Backend
BACKEND_IMAGE=compserve-admin:latest
BACKEND_CONTAINER_NAME=compserve-admin
BACKEND_UPLOAD_DIR=/opt/compserve/uploadPath
BACKEND_LOG_DIR=/opt/compserve/logs
RUOYI_PROFILE=/data/uploadPath

# Remote MySQL
DB_URL=jdbc:mysql://117.72.79.75:3306/compserve?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=true&serverTimezone=GMT%2B8
DB_USERNAME=root
DB_PASSWORD=replace-me

# MinIO
MINIO_ENDPOINT=http://117.72.79.75:9000/
MINIO_ACCESSKEY=minioadmin
MINIO_SECRETKEY=replace-me
MINIO_BUCKETNAME=compserve
MINIO_REGION=us-east-1
MINIO_USEHTTPS=false
PREVIEW_ALLOWED_HOSTS=117.72.79.75:9000

# OnlyOffice
ONLYOFFICE_URL=http://117.72.79.75:8080
ONLYOFFICE_PUBLIC_BASE_URL=

# Frontend build args
FRONTEND_IMAGE=compserve-ui:latest
FRONTEND_CONTAINER_NAME=compserve-ui
VITE_APP_BASE_API=/prod-api
VITE_APP_ONLYOFFICE_API=http://117.72.79.75:8080/web-apps/apps/api/documents/api.js
VITE_APP_MINIO_URL=http://117.72.79.75:9001

# Public access
HTTP_PORT=80

