<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.iflytek.system.mapper.MockExamRecordMapper">

    <resultMap id="MockExamRecordResult" type="org.iflytek.system.domain.MockExamRecord">
        <id     property="recordId"   column="record_id"/>
        <result property="paperId"    column="paper_id"/>
        <result property="userId"     column="user_id"/>
        <result property="startTime"  column="start_time"/>
        <result property="submitTime" column="submit_time"/>
        <result property="score"      column="score"/>
        <result property="totalScore" column="total_score"/>
        <result property="status"     column="status"/>
        <result property="paperTitle" column="paper_title"/>
    </resultMap>

    <insert id="insertMockExamRecord"
            parameterType="org.iflytek.system.domain.MockExamRecord"
            useGeneratedKeys="true"
            keyProperty="recordId">
        insert into mock_exam_record (
            paper_id,
            user_id,
            start_time,
            submit_time,
            score,
            total_score,
            status,
            paper_title
        ) values (
            #{paperId},
            #{userId},
            #{startTime},
            #{submitTime},
            #{score},
            #{totalScore},
            #{status},
            #{paperTitle}
        )
    </insert>

    <select id="selectMockExamRecordById" parameterType="long" resultMap="MockExamRecordResult">
        select
            record_id,
            paper_id,
            user_id,
            start_time,
            submit_time,
            score,
            total_score,
            status,
            paper_title
        from mock_exam_record
        where record_id = #{recordId}
    </select>

    <select id="selectRecordsByUserId" resultMap="MockExamRecordResult">
        select
            record_id,
            paper_id,
            user_id,
            start_time,
            submit_time,
            score,
            total_score,
            status,
            paper_title
        from mock_exam_record
        where user_id = #{userId}
        order by submit_time desc, record_id desc
    </select>

</mapper>

