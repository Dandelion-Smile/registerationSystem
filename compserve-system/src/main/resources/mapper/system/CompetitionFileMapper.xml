<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.iflytek.system.mapper.CompetitionFileMapper">
    <resultMap type="org.iflytek.system.domain.CompetitionFile" id="CompetitionFileResult">
        <id property="id" column="id" />
        <result property="competitionId" column="competition_id" />
        <result property="fileName" column="file_name" />
        <result property="fileDesc" column="file_desc" />
        <result property="fileSize" column="file_size" />
        <result property="fileType" column="file_type" />
        <result property="fileUrl" column="file_url" />
        <result property="downloadCount" column="download_count" />
        <result property="createTime" column="create_time" />
    </resultMap>

    <insert id="insertCompetitionFile" parameterType="org.iflytek.system.domain.CompetitionFile">
        INSERT INTO competition_file (
            competition_id,
            file_name,
            file_desc,
            file_size,
            file_type,
            file_url,
            download_count,
            create_time
        ) VALUES (
            #{competitionId},
            #{fileName},
            #{fileDesc},
            #{fileSize},
            #{fileType},
            #{fileUrl},
            0,
            NOW()
        )
    </insert>

    <delete id="deleteCompetitionFileByCompetitionId" parameterType="java.lang.Long">
        DELETE FROM competition_file WHERE competition_id = #{competitionId}
    </delete>

    <select id="selectCompetitionFilesByCompetitionId" parameterType="java.lang.Long" resultMap="CompetitionFileResult">
        SELECT * FROM competition_file WHERE competition_id = #{competitionId}
    </select>
</mapper>
