<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.iflytek.system.mapper.SysCollegeMajorMapper">
	
	<resultMap type="SysCollegeMajor" id="SysCollegeMajorResult">
		<id     property="id"           column="id"           />
		<result property="collegeName"  column="college_name"  />
		<result property="majorName"    column="major_name"    />
		<result property="sortOrder"    column="sort_order"    />
		<result property="status"       column="status"        />
		<result property="createBy"     column="create_by"     />
		<result property="createTime"   column="create_time"   />
		<result property="updateBy"     column="update_by"     />
		<result property="updateTime"   column="update_time"   />
		<result property="remark"       column="remark"        />
	</resultMap>
	
	<sql id="selectCollegeMajorVo">
        select id, college_name, major_name, sort_order, status, create_by, create_time, update_by, update_time, remark 
		from sys_college_major
    </sql>

	<select id="selectCollegeMajorList" parameterType="SysCollegeMajor" resultMap="SysCollegeMajorResult">
	    <include refid="selectCollegeMajorVo"/>
		<where>
		    <if test="collegeName != null and collegeName != ''">
				AND college_name like concat('%', #{collegeName}, '%')
			</if>
			<if test="majorName != null and majorName != ''">
				AND major_name like concat('%', #{majorName}, '%')
			</if>
			<if test="status != null and status != ''">
				AND status = #{status}
			</if>
		</where>
		order by college_name asc, sort_order asc
	</select>
	
	<select id="selectAllCollegeNames" resultType="String">
		select distinct college_name from sys_college_major 
		where status = '0' 
		order by college_name asc
	</select>
	
	<select id="selectMajorsByCollege" parameterType="String" resultType="String">
		select major_name from sys_college_major 
		where status = '0' and college_name = #{collegeName} 
		order by sort_order asc
	</select>
	
	<select id="selectCollegeMajorById" parameterType="Long" resultMap="SysCollegeMajorResult">
		<include refid="selectCollegeMajorVo"/>
		where id = #{id}
	</select>
	
	<delete id="deleteCollegeMajorById" parameterType="Long">
 		delete from sys_college_major where id = #{id}
 	</delete>
 	
 	<delete id="deleteCollegeMajorByIds" parameterType="Long">
 		delete from sys_college_major where id in
 		<foreach collection="array" item="id" open="(" separator="," close=")">
 			#{id}
        </foreach> 
 	</delete>
	
	<update id="updateCollegeMajor" parameterType="SysCollegeMajor">
 		update sys_college_major
 		<set>
 			<if test="collegeName != null and collegeName != ''">college_name = #{collegeName},</if>
 			<if test="majorName != null and majorName != ''">major_name = #{majorName},</if>
 			<if test="sortOrder != null">sort_order = #{sortOrder},</if>
 			<if test="status != null">status = #{status},</if>
 			<if test="remark != null">remark = #{remark},</if>
 			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
 			update_time = sysdate()
 		</set>
 		where id = #{id}
	</update>
 	
 	<insert id="insertCollegeMajor" parameterType="SysCollegeMajor">
 		insert into sys_college_major(
 			<if test="collegeName != null and collegeName != ''">college_name,</if>
 			<if test="majorName != null and majorName != ''">major_name,</if>
 			<if test="sortOrder != null">sort_order,</if>
 			<if test="status != null">status,</if>
 			<if test="remark != null and remark != ''">remark,</if>
 			<if test="createBy != null and createBy != ''">create_by,</if>
 			create_time
 		)values(
 		    <if test="collegeName != null and collegeName != ''">#{collegeName},</if>
 			<if test="majorName != null and majorName != ''">#{majorName},</if>
 			<if test="sortOrder != null">#{sortOrder},</if>
 			<if test="status != null">#{status},</if>
 			<if test="remark != null and remark != ''">#{remark},</if>
 			<if test="createBy != null and createBy != ''">#{createBy},</if>
 			sysdate()
 		)
	</insert>
	
</mapper> 
